<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!-- 🏔️ LAMMA ADVENTURE SIGNUP - OUTDOOR STYLE -->

<StackPane prefHeight="1000" prefWidth="1920" style="-fx-background-color: #1a2332;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignupController">

    <!-- Background Image -->
    <ImageView fitHeight="850.0" fitWidth="1366.0" pickOnBounds="true" preserveRatio="false">
        <image>
            <Image url="@clayton-manche--HtKP_ke858-unsplash.jpg" />
        </image>
    </ImageView>

    <!-- Dark Overlay -->
    <StackPane style="-fx-background-color: rgba(0, 0, 0, 0.50);" />

    <!-- Main Container -->
    <BorderPane>

        <!-- Windows Controls -->
        <top>
            <HBox alignment="CENTER_RIGHT" prefHeight="0.0" prefWidth="1366.0" spacing="0" style="-fx-background-color: transparent;">
                <Button fx:id="minimizeBtn" onAction="#handleMinimize" onMouseEntered="#onMinimizeHover" onMouseExited="#onMinimizeExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14; -fx-cursor: hand;" text="─" />
                <Button fx:id="maximizeBtn" onAction="#handleMaximize" onMouseEntered="#onMaximizeHover" onMouseExited="#onMaximizeExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14; -fx-cursor: hand;" text="❐" />
                <Button fx:id="closeBtn" onAction="#handleClose" onMouseEntered="#onCloseHover" onMouseExited="#onCloseExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14; -fx-cursor: hand;" text="✕" />
            </HBox>
        </top>

        <!-- Center Content -->
        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;">
                <content>
                    <VBox alignment="TOP_CENTER" prefHeight="1238.0" prefWidth="1296.0" spacing="0" style="-fx-padding: 30 0 40 0;">

                        <!-- Logo -->
                        <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@logo.png" />
                            </image>
                            <VBox.margin>
                                <Insets bottom="15" />
                            </VBox.margin>
                        </ImageView>

                        <!-- Title -->
                        <VBox alignment="CENTER" spacing="6">
                            <VBox.margin>
                                <Insets bottom="25" />
                            </VBox.margin>
                            <Label style="-fx-text-fill: white; -fx-font-size: 32; -fx-font-weight: 700; -fx-letter-spacing: 1.5;" text="JOIN THE ADVENTURE" />
                            <Label style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 14; -fx-font-weight: 500;" text="Begin your journey into the wilderness 🌲" />
                        </VBox>

                        <!-- Signup Card - Dark Glassmorphism -->
                        <VBox alignment="TOP_CENTER" maxWidth="520" prefWidth="520" spacing="16" style="-fx-background-color: rgba(26, 35, 50, 0.85); -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 30, 0, 0, 10);">

                            <padding>
                                <Insets bottom="35" left="40" right="40" top="35" />
                            </padding>

                            <!-- Profile Photo Upload -->
                            <VBox alignment="CENTER" spacing="12">
                                <StackPane>
                                    <Circle fill="rgba(255, 140, 66, 0.2)" radius="50" stroke="rgba(255, 140, 66, 0.5)" strokeWidth="2" />
                                    <ImageView fx:id="profileImageView" fitHeight="90" fitWidth="90" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@default-avatar.png" />
                                        </image>
                                    </ImageView>
                                </StackPane>

                                <Button fx:id="uploadPhotoBtn" style="-fx-background-color: rgba(255, 140, 66, 0.2); -fx-text-fill: #FFB380; -fx-font-size: 12; -fx-font-weight: 600; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-border-color: rgba(255, 140, 66, 0.4); -fx-border-width: 1; -fx-border-radius: 20;" text="📷 Upload Photo" />
                            </VBox>

                            <!-- Divider -->
                            <HBox alignment="CENTER" spacing="12">
                                <Separator prefWidth="160" style="-fx-background-color: rgba(255,255,255,0.15);" />
                                <Label style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 10; -fx-font-weight: 700; -fx-letter-spacing: 1;" text="TRAIL INFO" />
                                <Separator prefWidth="160" style="-fx-background-color: rgba(255,255,255,0.15);" />
                            </HBox>

                            <!-- Form Fields -->
                            <VBox prefWidth="440" spacing="14">

                                <!-- Username -->
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" text="TRAIL NAME" />
                                    <TextField fx:id="UserName" prefHeight="46" promptText="Choose your trail name" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14;" />
                                    <Label fx:id="usernameError" style="-fx-text-fill: #FF6B6B; -fx-font-size: 11; -fx-font-weight: 600;" visible="false" />
                                </VBox>

                                <!-- Email -->
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" text="EMAIL" />
                                    <TextField fx:id="email" prefHeight="46" promptText="hiker@wilderness.com" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14;" />
                                    <Label fx:id="emailError" style="-fx-text-fill: #FF6B6B; -fx-font-size: 11; -fx-font-weight: 600;" visible="false" />
                                </VBox>

                                <!-- Phone -->
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" text="EMERGENCY CONTACT" />
                                    <TextField fx:id="phone" prefHeight="46" promptText="12345678" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14;" />
                                    <Label fx:id="phoneError" style="-fx-text-fill: #FF6B6B; -fx-font-size: 11; -fx-font-weight: 600;" visible="false" />
                                </VBox>

                                <!-- Motorized -->
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" text="VEHICLE ACCESS" />
                                    <ComboBox fx:id="motorizedCombo" maxWidth="Infinity" prefHeight="46" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-font-size: 14;" />
                                </VBox>

                                <!-- Password -->
                                <VBox spacing="8">
                                    <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" text="SECRET CODE" />

                                    <StackPane>
                                        <PasswordField fx:id="password" prefHeight="46" promptText="Create a strong password" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14;" />

                                        <TextField fx:id="passwordVisible" prefHeight="46" promptText="Create a strong password" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12; -fx-font-size: 14;" visible="false" />

                                        <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand;" StackPane.alignment="CENTER_RIGHT">
                                            <graphic>
                                                <Label fx:id="eyeIcon" style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.6);" text="👁" />
                                            </graphic>
                                            <StackPane.margin>
                                                <Insets right="12" />
                                            </StackPane.margin>
                                        </Button>
                                    </StackPane>

                                    <Label fx:id="passwordStrength" style="-fx-font-size: 11; -fx-font-weight: 600;" />
                                    <Label fx:id="passwordError" style="-fx-text-fill: #FF6B6B; -fx-font-size: 11; -fx-font-weight: 600;" visible="false" />
                                </VBox>

                            </VBox>

                            <!-- CAPTCHA -->
                            <HBox fx:id="captchaContainer" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(15, 23, 42, 0.4); -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 14;">
                                <Label style="-fx-font-size: 16;" text="🔐" />
                                <Label fx:id="captchaQuestion" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13; -fx-font-weight: 600;" text="What is 5 + 3 ?" />
                                <TextField fx:id="captchaInput" prefHeight="38" prefWidth="80" promptText="?" style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.3); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 14; -fx-alignment: center;" />
                            </HBox>

                            <!-- Signup Button - ORANGE -->
                            <Button fx:id="Signup" maxWidth="440" onAction="#handleSignup" prefHeight="52" style="-fx-background-color: linear-gradient(to right, #FF8C42 0%, #FF6B35 100%); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: 700; -fx-background-radius: 26; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255, 107, 53, 0.4), 15, 0, 0, 5); -fx-letter-spacing: 1;" text="BEGIN YOUR JOURNEY">
                                <VBox.margin>
                                    <Insets top="6" />
                                </VBox.margin>
                            </Button>

                            <!-- Login Link -->
                            <HBox alignment="CENTER" spacing="6">
                                <Label style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 13; -fx-font-weight: 500;" text="Already a trailblazer?" />
                                <Hyperlink fx:id="loginLink" onAction="#goToLogin" style="-fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13; -fx-font-weight: 600; -fx-underline: false;" text="Sign in here" />
                            </HBox>

                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>
        </center>

    </BorderPane>

</StackPane>
