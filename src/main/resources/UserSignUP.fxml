<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1010.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SignupController">

    <!-- TOP BAR - Windows Controls -->
    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="32.0" spacing="0" style="-fx-background-color: #ffffff;">
            <Button fx:id="minimizeBtn" onAction="#handleMinimize" onMouseEntered="#onMinimizeHover" onMouseExited="#onMinimizeExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: #000000; -fx-font-size: 12; -fx-cursor: hand;" text="─" />
            <Button fx:id="maximizeBtn" onAction="#handleMaximize" onMouseEntered="#onMaximizeHover" onMouseExited="#onMaximizeExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: #000000; -fx-font-size: 12; -fx-cursor: hand;" text="❐" />
            <Button fx:id="closeBtn" onAction="#handleClose" onMouseEntered="#onCloseHover" onMouseExited="#onCloseExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: #000000; -fx-font-size: 12; -fx-cursor: hand;" text="✕" />
        </HBox>
    </top>

    <!-- LEFT SECTION - Form -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="718.0">
            <content>
                <AnchorPane prefWidth="500" style="-fx-background-color: #ffffff;">

                    <!-- Main Form Container -->
                    <VBox alignment="TOP_CENTER" spacing="16" AnchorPane.leftAnchor="60" AnchorPane.rightAnchor="60" AnchorPane.topAnchor="40" AnchorPane.bottomAnchor="40">

                        <!-- Logo and Title -->
                        <VBox alignment="CENTER" prefWidth="380.0" spacing="6">
                            <ImageView fitHeight="50.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@logo.png" />
                                </image>
                            </ImageView>
                            <Label text="Join LAMMA">
                                <font>
                                    <Font name="System Bold" size="22" />
                                </font>
                            </Label>
                            <Label style="-fx-text-fill: #718096; -fx-font-size: 12;" text="Create your account to get started" />
                        </VBox>

                        <!-- Profile Photo Upload -->
                        <VBox alignment="CENTER" spacing="10">
                            <StackPane>
                                <ImageView fx:id="profileImageView" fitHeight="90" fitWidth="90" pickOnBounds="true" preserveRatio="true" style="-fx-background-color: #f7fafc; -fx-background-radius: 45;">
                                    <image>
                                        <Image url="@default-avatar.png" />
                                    </image>
                                </ImageView>
                            </StackPane>
                            <Button fx:id="uploadPhotoBtn" style="-fx-background-color: #7B5FF5; -fx-text-fill: white; -fx-font-size: 11; -fx-background-radius: 8; -fx-padding: 7 14; -fx-cursor: hand;" text="📷 Upload Photo" />
                        </VBox>

                        <!-- Divider -->
                        <HBox alignment="CENTER" spacing="10">
                            <Separator prefWidth="140" style="-fx-background-color: #e2e8f0;" />
                            <Label style="-fx-text-fill: #a0aec0; -fx-font-size: 10; -fx-font-weight: 600;" text="ACCOUNT DETAILS" />
                            <Separator prefWidth="140" style="-fx-background-color: #e2e8f0;" />
                        </HBox>

                        <!-- Form Fields -->
                        <VBox spacing="11">

                            <!-- Username -->
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #4a5568; -fx-font-size: 11; -fx-font-weight: 600;" text="Username">
                                    <padding>
                                        <Insets left="4" />
                                    </padding>
                                </Label>
                                <TextField fx:id="UserName" prefHeight="40" promptText="Enter your username" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;" />
                                <Label fx:id="usernameError" style="-fx-text-fill: #e53e3e; -fx-font-size: 10;" visible="false" />
                            </VBox>

                            <!-- Email -->
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #4a5568; -fx-font-size: 11; -fx-font-weight: 600;" text="Email">
                                    <padding>
                                        <Insets left="4" />
                                    </padding>
                                </Label>
                                <TextField fx:id="email" prefHeight="40" promptText="your@email.com" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;" />
                                <Label fx:id="emailError" style="-fx-text-fill: #e53e3e; -fx-font-size: 10;" visible="false" />
                            </VBox>

                            <!-- Phone Number -->
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #4a5568; -fx-font-size: 11; -fx-font-weight: 600;" text="Phone Number">
                                    <padding>
                                        <Insets left="4" />
                                    </padding>
                                </Label>
                                <TextField fx:id="phone" prefHeight="40" promptText="12345678" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;" />
                                <Label fx:id="phoneError" style="-fx-text-fill: #e53e3e; -fx-font-size: 10;" visible="false" />
                            </VBox>

                            <!-- Motorized -->
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #4a5568; -fx-font-size: 11; -fx-font-weight: 600;" text="Do you have a vehicle?">
                                    <padding>
                                        <Insets left="4" />
                                    </padding>
                                </Label>
                                <ComboBox fx:id="motorizedCombo" prefHeight="40" prefWidth="380" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                            </VBox>

                            <!-- Password -->
                            <VBox spacing="5">
                                <Label style="-fx-text-fill: #4a5568; -fx-font-size: 11; -fx-font-weight: 600;" text="Password">
                                    <padding>
                                        <Insets left="4" />
                                    </padding>
                                </Label>
                                <StackPane>
                                    <PasswordField fx:id="password" prefHeight="40" promptText="Minimum 6 characters" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;" />
                                    <TextField fx:id="passwordVisible" prefHeight="40" promptText="Minimum 6 characters" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13;" visible="false" />
                                    <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand;" StackPane.alignment="CENTER_RIGHT">
                                        <graphic>
                                            <Label fx:id="eyeIcon" style="-fx-font-size: 15; -fx-text-fill: #718096;" text="👁" />
                                        </graphic>
                                        <StackPane.margin>
                                            <Insets right="10" />
                                        </StackPane.margin>
                                    </Button>
                                </StackPane>
                                <Label fx:id="passwordStrength" style="-fx-font-size: 10;" />
                                <Label fx:id="passwordError" style="-fx-text-fill: #e53e3e; -fx-font-size: 10;" visible="false" />
                            </VBox>

                        </VBox>

                        <!-- ✅ SIMPLE MATH CAPTCHA (No WebView!) -->
                        <HBox fx:id="captchaContainer" spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                            <Label style="-fx-text-fill: #4a5568; -fx-font-size: 12; -fx-font-weight: 700;" text="🔐" />
                            <Label fx:id="captchaQuestion" style="-fx-text-fill: #1e293b; -fx-font-size: 13; -fx-font-weight: 600;" text="What is 5 + 3 ?" />
                            <TextField fx:id="captchaInput" prefHeight="36" prefWidth="80" promptText="Answer" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13; -fx-alignment: center;" />
                        </HBox>

                        <!-- Signup Button -->
                        <Button fx:id="Signup" maxWidth="Infinity" onAction="#handleSignup" prefHeight="44.0" prefWidth="380.0" style="-fx-background-color: #7B5FF5; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 10; -fx-cursor: hand;" text="Create Account">
                            <VBox.margin>
                                <Insets top="4" />
                            </VBox.margin>
                        </Button>

                        <!-- Login Link -->
                        <HBox alignment="CENTER" spacing="5">
                            <VBox.margin>
                                <Insets bottom="10" />
                            </VBox.margin>
                            <Label style="-fx-text-fill: #718096; -fx-font-size: 12;" text="Already have an account?" />
                            <Hyperlink fx:id="loginLink" onAction="#goToLogin" style="-fx-text-fill: #7B5FF5; -fx-font-size: 12; -fx-font-weight: 600;" text="Sign in" />
                        </HBox>

                    </VBox>

                </AnchorPane>
            </content>
        </ScrollPane>
    </left>

    <!-- RIGHT SECTION - Image -->
    <center>
        <StackPane prefHeight="718.0" prefWidth="510.0">
            <ImageView fitHeight="800.0" fitWidth="667.0" preserveRatio="false">
                <image>
                    <Image url="@clayton-manche--HtKP_ke858-unsplash.jpg" />
                </image>
            </ImageView>
            <StackPane style="-fx-background-color: rgba(0, 0, 0, 0.3);" />
            <VBox alignment="BOTTOM_LEFT" spacing="14">
                <padding>
                    <Insets bottom="60" left="50" right="50" />
                </padding>
                <VBox alignment="BOTTOM_LEFT" spacing="8">
                    <Label style="-fx-text-fill: white; -fx-font-size: 44; -fx-font-weight: 700; -fx-line-spacing: 4;" text="Your next" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 44; -fx-font-weight: 700;" text="adventure" />
                    <HBox spacing="8">
                        <Label style="-fx-text-fill: white; -fx-font-size: 44; -fx-font-weight: 700;" text="starts" />
                        <Label style="-fx-text-fill: #7B5FF5; -fx-font-size: 44; -fx-font-weight: 700; -fx-background-color: white; -fx-padding: 0 12; -fx-background-radius: 8;" text="here" />
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
