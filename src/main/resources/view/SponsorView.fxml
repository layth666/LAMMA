<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.SponsorViewController"
      styleClass="content-card"
      spacing="0">

    <!-- Barre titre section -->
    <HBox styleClass="section-header" alignment="CENTER_LEFT">
        <padding>
            <Insets top="10" right="15" bottom="10" left="15"/>
        </padding>
        <Label text="📋 Gestion des Sponsors" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
    </HBox>

    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <!-- Boutons et recherche -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button text="+ Nouveau Sponsor" onAction="#ajouterSponsor" styleClass="btn-add"/>
            <Button text="Actualiser" onAction="#actualiser" styleClass="btn-refresh"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtRecherche" promptText="Rechercher un sponsor..." styleClass="search-field" prefWidth="250"/>
        </HBox>

        <!-- Filtres -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Filtres :" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="cboFiltreStatut" styleClass="combo-box" prefWidth="120"/>
            <ComboBox fx:id="cboTri" styleClass="combo-box" prefWidth="150"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblCount" text="0 sponsors"/>
            <Button text="✕ Réinitialiser" onAction="#reinitialiserFiltres" styleClass="btn-reset"/>
        </HBox>

        <!-- Formulaire -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 12; -fx-background-radius: 4;">
            <Label text="Nom :" style="-fx-min-width: 70;"/>
            <TextField fx:id="txtNom" promptText="Nom du sponsor" prefWidth="150"/>
            <Label text="Téléphone :" style="-fx-min-width: 70;"/>
            <TextField fx:id="txtTelephone" promptText="+21612345678" prefWidth="140"/>
            <Label text="Email :" style="-fx-min-width: 50;"/>
            <TextField fx:id="txtEmail" promptText="email@exemple.com" prefWidth="180"/>
            <Label text="Logo :" style="-fx-min-width: 40;"/>
            <TextField fx:id="txtLogo" promptText="Choisir une image..." prefWidth="120" editable="false"/>
            <Button text="Parcourir..." onAction="#choisirLogo" styleClass="btn-refresh"/>
            <ImageView fx:id="imgLogoPreview" fitHeight="40" fitWidth="40" preserveRatio="true" pickOnBounds="true"/>
            <CheckBox fx:id="chkStatut" text="Actif"/>
        </HBox>

        <!-- Boutons d'action -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Ajouter" onAction="#ajouterSponsor" styleClass="btn-add"/>
            <Button text="Modifier" onAction="#modifierSponsor" styleClass="btn-modify"/>
            <Button text="Supprimer" onAction="#supprimerSponsor" styleClass="btn-delete"/>
            <Button text="Annuler" onAction="#annuler" styleClass="btn-cancel"/>
        </HBox>

        <!-- Liste des sponsors (format cartes) -->
        <Label text="📋 Liste des Sponsors" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <ListView fx:id="listSponsors" VBox.vgrow="ALWAYS" styleClass="list-sponsors" prefHeight="300"/>
    </VBox>

</VBox>
