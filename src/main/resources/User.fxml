<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<!-- 🏔️ LAMMA ADVENTURE LOGIN - OUTDOOR STYLE -->
<StackPane prefHeight="1050" prefWidth="1920"
           style="-fx-background-color: #1a2332;"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controller.Logincontroller">

    <!-- Background Image Layer -->
    <ImageView fitHeight="768.0" fitWidth="1366.0" preserveRatio="false" pickOnBounds="true">
        <image>
            <Image url="@clayton-manche--HtKP_ke858-unsplash.jpg" />
        </image>
    </ImageView>

    <!-- Dark Overlay -->
    <StackPane style="-fx-background-color: rgba(0, 0, 0, 0.45);" />

    <!-- Main Container -->
    <BorderPane>

        <!-- Windows Controls -->
        <top>
            <HBox alignment="CENTER_RIGHT" prefHeight="32" spacing="0" style="-fx-background-color: transparent;">
                <Button fx:id="minimizeBtn" onAction="#handleMinimize"
                        onMouseEntered="#onMinimizeHover" onMouseExited="#onMinimizeExit"
                        prefHeight="32" prefWidth="46"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14; -fx-cursor: hand;" text="─" />
                <Button fx:id="maximizeBtn" onAction="#handleMaximize"
                        onMouseEntered="#onMaximizeHover" onMouseExited="#onMaximizeExit"
                        prefHeight="32" prefWidth="46"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14; -fx-cursor: hand;" text="❐" />
                <Button fx:id="closeBtn" onAction="#handleClose"
                        onMouseEntered="#onCloseHover" onMouseExited="#onCloseExit"
                        prefHeight="32" prefWidth="46"
                        style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 14; -fx-cursor: hand;" text="✕" />
            </HBox>
        </top>

        <!-- Center Content -->
        <center>
            <VBox alignment="CENTER" spacing="0">

                <!-- Logo Mascot -->
                <ImageView fitHeight="120.0" fitWidth="120.0" preserveRatio="true" pickOnBounds="true">
                    <image>
                        <Image url="@logo.png" />
                    </image>
                    <VBox.margin>
                        <Insets bottom="20" />
                    </VBox.margin>
                </ImageView>

                <!-- Title -->
                <VBox alignment="CENTER" spacing="8">
                    <VBox.margin>
                        <Insets bottom="30" />
                    </VBox.margin>

                    <Label text="LAMMA ADVENTURE"
                           style="-fx-text-fill: white; -fx-font-size: 36; -fx-font-weight: 700; -fx-letter-spacing: 2;" />

                    <Label text="Your gateway to the great outdoors 🌲"
                           style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 15; -fx-font-weight: 500;" />
                </VBox>

                <!-- Login Card - Dark Glassmorphism -->
                <VBox alignment="TOP_CENTER" spacing="24"
                      style="-fx-background-color: rgba(26, 35, 50, 0.85); -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 30, 0, 0, 10);"
                      prefWidth="480"
                      maxWidth="480">

                    <padding>
                        <Insets top="40" right="40" bottom="40" left="40" />
                    </padding>

                    <!-- Welcome Header -->
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="Welcome back"
                               style="-fx-text-fill: white; -fx-font-size: 28; -fx-font-weight: 700;" />

                        <Label text="Enter your trail credentials below"
                               style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 14; -fx-font-weight: 500;" />
                    </VBox>

                    <!-- Social Login Buttons -->
                    <HBox alignment="CENTER">

                        <!-- Facebook Button -->


                        <!-- Google Button -->
                        <Button fx:id="googleLoginBtn"
                                onAction="#handleGoogleLogin"
                                prefHeight="46" prefWidth="200"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13; -fx-font-weight: 600; -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5; -fx-border-radius: 23; -fx-background-radius: 23; -fx-cursor: hand;">
                            <graphic>
                                <HBox alignment="CENTER" spacing="8">
                                    <Label text="G" style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 14;" />
                                    <Label text="GOOGLE" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 13;" />
                                </HBox>
                            </graphic>
                        </Button>

                    </HBox>

                    <!-- Face ID Button -->
                    <Button fx:id="faceIDLoginBtn"
                            onAction="#handleFaceIDLogin"
                            prefHeight="46"
                            maxWidth="420"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 13; -fx-font-weight: 600; -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5; -fx-border-radius: 23; -fx-background-radius: 23; -fx-cursor: hand;">
                        <graphic>
                            <HBox alignment="CENTER" spacing="10">
                                <Label text="🔐" style="-fx-font-size: 16;" />
                                <Label text="SIGN IN WITH FACE ID" style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 13;" />
                            </HBox>
                        </graphic>
                    </Button>

                    <!-- Divider -->
                    <HBox alignment="CENTER" spacing="15" prefWidth="420">
                        <Separator prefWidth="180" style="-fx-background-color: rgba(255,255,255,0.2);" />
                        <Label text="OR" style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12; -fx-font-weight: 600;" />
                        <Separator prefWidth="180" style="-fx-background-color: rgba(255,255,255,0.2);" />
                    </HBox>

                    <!-- Form Fields -->
                    <VBox spacing="20" prefWidth="420">

                        <!-- Email -->
                        <VBox spacing="10">
                            <Label text="EMAIL ADDRESS"
                                   style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" />

                            <TextField fx:id="emailField"
                                       promptText="explorer@hiking.com"
                                       prefHeight="50"
                                       style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14; -fx-font-size: 14;" />
                        </VBox>

                        <!-- Password -->
                        <VBox spacing="10">
                            <Label text="PASSWORD"
                                   style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 11; -fx-font-weight: 700; -fx-letter-spacing: 0.5;" />

                            <StackPane>
                                <PasswordField fx:id="passwordField"
                                               promptText="Your secret path"
                                               prefHeight="50"
                                               style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14; -fx-font-size: 14;" />

                                <TextField fx:id="passwordVisible"
                                           promptText="Your secret path"
                                           prefHeight="50"
                                           visible="false"
                                           style="-fx-background-color: rgba(15, 23, 42, 0.6); -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.4); -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14; -fx-font-size: 14;" />

                                <Button fx:id="togglePasswordBtn"
                                        onAction="#togglePasswordVisibility"
                                        style="-fx-background-color: transparent; -fx-cursor: hand;"
                                        StackPane.alignment="CENTER_RIGHT">
                                    <graphic>
                                        <Label fx:id="eyeIcon"
                                               text="👁"
                                               style="-fx-font-size: 16; -fx-text-fill: rgba(255,255,255,0.6);" />
                                    </graphic>
                                    <StackPane.margin>
                                        <Insets right="14" />
                                    </StackPane.margin>
                                </Button>
                            </StackPane>
                        </VBox>

                    </VBox>

                    <!-- Remember & Forgot -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <CheckBox text="Keep me signed in"
                                  style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 13; -fx-font-weight: 500;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Hyperlink fx:id="forgotPasswordLink"
                                   onAction="#handleForgotPassword"
                                   text="Lost your map?"
                                   style="-fx-text-fill: #FF8C42; -fx-font-size: 13; -fx-font-weight: 600; -fx-underline: false;" />
                    </HBox>

                    <!-- Login Button - ORANGE -->
                    <Button fx:id="loginBtn"
                            text="START EXPLORING"
                            onAction="#handleLogin"
                            prefHeight="54"
                            maxWidth="420"
                            style="-fx-background-color: linear-gradient(to right, #FF8C42 0%, #FF6B35 100%); -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: 700; -fx-background-radius: 27; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255, 107, 53, 0.4), 15, 0, 0, 5); -fx-letter-spacing: 1;">
                        <VBox.margin>
                            <Insets top="10" />
                        </VBox.margin>
                    </Button>

                    <!-- Signup Link -->
                    <HBox alignment="CENTER" spacing="6">
                        <Label text="New hiker?"
                               style="-fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 14; -fx-font-weight: 500;" />

                        <Hyperlink fx:id="signupLink"
                                   onAction="#goToSignup"
                                   text="Join our team"
                                   style="-fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 14; -fx-font-weight: 600; -fx-underline: false;" />
                    </HBox>

                </VBox>

            </VBox>
        </center>

    </BorderPane>

</StackPane>
