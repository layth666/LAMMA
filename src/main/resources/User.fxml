<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="1010.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Logincontroller">

    <!-- TOP BAR - Windows Controls -->
    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="32.0" spacing="0" style="-fx-background-color: #ffffff;">
            <Button fx:id="minimizeBtn" onAction="#handleMinimize" onMouseEntered="#onMinimizeHover" onMouseExited="#onMinimizeExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: #000000; -fx-font-size: 12; -fx-cursor: hand;" text="─" />
            <Button fx:id="maximizeBtn" onAction="#handleMaximize" onMouseEntered="#onMaximizeHover" onMouseExited="#onMaximizeExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: #000000; -fx-font-size: 12; -fx-cursor: hand;" text="❐" />
            <Button fx:id="closeBtn" onAction="#handleClose" onMouseEntered="#onCloseHover" onMouseExited="#onCloseExit" prefHeight="32" prefWidth="46" style="-fx-background-color: transparent; -fx-text-fill: #000000; -fx-font-size: 12; -fx-cursor: hand;" text="✕" />
        </HBox>
    </top>

    <!-- LEFT SECTION - Form -->
    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="568.0">
            <content>
                <AnchorPane prefWidth="500" style="-fx-background-color: #ffffff;">

                    <!-- Main Form Container -->
                    <VBox alignment="TOP_CENTER" spacing="20" AnchorPane.leftAnchor="60" AnchorPane.rightAnchor="60" AnchorPane.topAnchor="60">

                        <!-- Logo and Title -->
                        <VBox alignment="CENTER" prefWidth="380.0" spacing="8">
                            <ImageView fitHeight="60.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@logo.png" />
                                </image>
                            </ImageView>
                            <Label text="Welcome Back">
                                <font>
                                    <Font name="System Bold" size="28" />
                                </font>
                            </Label>
                            <Label style="-fx-text-fill: #718096; -fx-font-size: 14;" text="Sign in to continue to LAMMA" />
                        </VBox>

                        <!-- Google Sign In Button - PROFESSIONAL STYLE -->
                        <Button fx:id="googleLoginBtn" onAction="#handleGoogleLogin" maxWidth="380" prefHeight="50" prefWidth="380" style="-fx-background-color: white; -fx-border-color: #dadce0; -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                            <graphic>
                                <HBox alignment="CENTER" spacing="12">
                                    <!-- Google Logo SVG Icon -->
                                    <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                        <image>
                                            <Image url="@google.png" />
                                        </image>
                                    </ImageView>
                                    <Label style="-fx-text-fill: #3c4043; -fx-font-size: 14; -fx-font-weight: 600; -fx-font-family: 'Roboto', sans-serif;" text="Sign in with Google" />
                                </HBox>
                            </graphic>
                        </Button>
                        <Button fx:id="faceIDLoginBtn"
                                onAction="#handleFaceIDLogin"
                                maxWidth="380"
                                prefHeight="50"
                                prefWidth="380"
                                style="-fx-background-color: white;
               -fx-border-color: #dadce0;
               -fx-border-width: 1;
               -fx-border-radius: 6;
               -fx-background-radius: 6;
               -fx-cursor: hand;
               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">

                            <graphic>
                                <HBox alignment="CENTER" spacing="12">

                                    <!-- Face ID Icon -->
                                    <ImageView fitHeight="20"
                                               fitWidth="20"
                                               preserveRatio="true">
                                        <image>
                                            <Image url="@faceid.png"/>
                                        </image>
                                    </ImageView>

                                    <Label text="Sign in with Face ID"
                                           style="-fx-text-fill: #3c4043;
                          -fx-font-size: 14;
                          -fx-font-weight: 600;
                          -fx-font-family: 'Roboto', sans-serif;" />

                                </HBox>
                            </graphic>
                        </Button>

                        <!-- Divider -->
                        <HBox alignment="CENTER" spacing="15" prefWidth="380">
                            <VBox.margin>
                                <Insets top="10" bottom="10" />
                            </VBox.margin>
                            <Separator prefWidth="160" style="-fx-background-color: #e2e8f0;" />
                            <Label style="-fx-text-fill: #a0aec0; -fx-font-size: 12; -fx-font-weight: 500;" text="OR" />
                            <Separator prefWidth="160" style="-fx-background-color: #e2e8f0;" />
                        </HBox>

                        <!-- Form Fields -->
                        <VBox spacing="16" prefWidth="380">

                            <!-- Email -->
                            <VBox spacing="8">
                                <Label style="-fx-text-fill: #2d3748; -fx-font-size: 13; -fx-font-weight: 600;" text="Email Address">
                                    <padding>
                                        <Insets left="2" />
                                    </padding>
                                </Label>
                                <TextField fx:id="emailField" prefHeight="46" promptText="Enter your email" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14;" />
                            </VBox>

                            <!-- Password -->
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT">
                                    <Label style="-fx-text-fill: #2d3748; -fx-font-size: 13; -fx-font-weight: 600;" text="Password">
                                        <padding>
                                            <Insets left="2" />
                                        </padding>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPassword" style="-fx-text-fill: #7B5FF5; -fx-font-size: 12; -fx-font-weight: 600;" text="Forgot?" />
                                </HBox>
                                <StackPane>
                                    <PasswordField fx:id="passwordField" prefHeight="46" promptText="Enter your password" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14;" />
                                    <TextField fx:id="passwordVisible" prefHeight="46" promptText="Enter your password" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14;" visible="false" />
                                    <Button fx:id="togglePasswordBtn" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand;" StackPane.alignment="CENTER_RIGHT">
                                        <graphic>
                                            <Label fx:id="eyeIcon" style="-fx-font-size: 16; -fx-text-fill: #718096;" text="👁" />
                                        </graphic>
                                        <StackPane.margin>
                                            <Insets right="12" />
                                        </StackPane.margin>
                                    </Button>
                                </StackPane>
                            </VBox>

                            <!-- Remember Me -->
                            <HBox alignment="CENTER_LEFT">
                                <CheckBox style="-fx-text-fill: #4a5568; -fx-font-size: 13;" text="Remember me for 30 days" />
                            </HBox>

                        </VBox>

                        <!-- Login Button -->
                        <Button fx:id="loginBtn" maxWidth="380" onAction="#handleLogin" prefHeight="50" prefWidth="380" style="-fx-background-color: #7B5FF5; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: 600; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(123,95,245,0.3), 8, 0, 0, 4);" text="Sign In">
                            <VBox.margin>
                                <Insets top="8" />
                            </VBox.margin>
                        </Button>

                        <!-- Signup Link -->
                        <HBox alignment="CENTER" spacing="6">
                            <VBox.margin>
                                <Insets top="8" bottom="40" />
                            </VBox.margin>
                            <Label style="-fx-text-fill: #718096; -fx-font-size: 14;" text="Don't have an account?" />
                            <Hyperlink fx:id="signupLink" onAction="#goToSignup" style="-fx-text-fill: #7B5FF5; -fx-font-size: 14; -fx-font-weight: 600; -fx-underline: false;" text="Sign up" />
                        </HBox>

                    </VBox>

                </AnchorPane>
            </content>
        </ScrollPane>
    </left>

    <!-- RIGHT SECTION - Image -->
    <center>
        <StackPane prefHeight="568.0" prefWidth="460.0">
            <ImageView fitHeight="735.0" fitWidth="667.0" preserveRatio="false">
                <image>
                    <Image url="@clayton-manche--HtKP_ke858-unsplash.jpg" />
                </image>
            </ImageView>
            <StackPane style="-fx-background-color: rgba(0, 0, 0, 0.3);" />
            <VBox alignment="BOTTOM_LEFT" spacing="16">
                <padding>
                    <Insets bottom="60" left="50" right="50" />
                </padding>
                <VBox alignment="BOTTOM_LEFT" spacing="8">
                    <VBox.margin>
                        <Insets top="150" />
                    </VBox.margin>
                    <Label style="-fx-text-fill: white; -fx-font-size: 44; -fx-font-weight: 700; -fx-line-spacing: 4;" text="Your next" />
                    <Label style="-fx-text-fill: white; -fx-font-size: 44; -fx-font-weight: 700;" text="adventure" />
                    <HBox spacing="8">
                        <Label style="-fx-text-fill: white; -fx-font-size: 44; -fx-font-weight: 700;" text="starts" />
                        <Label style="-fx-text-fill: #7B5FF5; -fx-font-size: 44; -fx-font-weight: 700; -fx-background-color: white; -fx-padding: 0 12; -fx-background-radius: 8;" text="here" />
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
