<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!-- 🎨 DASHBOARD MODERNE - FOND SOMBRE AVEC GLASSMORPHISM -->
<BorderPane prefHeight="900.0" prefWidth="1600.0"
            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #1a1f2e 0%, #2d1b2e 50%, #1e2a3a 100%);"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardController">

    <!-- TOP BAR - DARK GLASSMORPHISM -->
    <top>
        <VBox>
            <!-- Windows Controls - Dark -->
            <HBox alignment="CENTER_RIGHT" prefHeight="32"
                  style="-fx-background-color: rgba(30, 41, 59, 0.7); -fx-backdrop-blur: 20px;">
                <Button onAction="#minimizeWindow" prefHeight="32" prefWidth="45"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand; -fx-font-size: 16;" text="─" />
                <Button onAction="#maximizeWindow" prefHeight="32" prefWidth="45"
                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand; -fx-font-size: 16;" text="❐" />
                <Button onAction="#closeWindow" prefHeight="32" prefWidth="45"
                        style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-cursor: hand; -fx-font-size: 16;" text="✕" />
            </HBox>

            <!-- Top Bar Glassmorphism -->
            <HBox alignment="CENTER_LEFT" prefHeight="55.0"
                  style="-fx-background-color: rgba(30, 41, 59, 0.6); -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets left="280" right="40" />
                </padding>

                <!-- Search Bar - Glassmorphism -->
                <HBox alignment="CENTER_LEFT" prefWidth="350" spacing="12"
                      style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 12; -fx-padding: 14 20; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 12;">
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 16;" text="🔍" />
                    <TextField fx:id="searchField" promptText="Scout the application..."
                               style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14; -fx-text-fill: #e2e8f0; -fx-prompt-text-fill: #64748b;">
                        <HBox.hgrow>ALWAYS</HBox.hgrow>
                    </TextField>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Status Indicator -->
                <HBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 20; -fx-padding: 8 16; -fx-border-color: rgba(239, 68, 68, 0.3); -fx-border-width: 1; -fx-border-radius: 20;">
                    <Circle fill="#ef4444" radius="4" />
                    <Label style="-fx-text-fill: #f87171; -fx-font-size: 12; -fx-font-weight: 600;" text="GEMINI AI: OFFLINE" />
                </HBox>

                <!-- User Profile - Glassmorphism -->
                <HBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 25; -fx-padding: 8 20 8 8; -fx-cursor: hand; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 25;">
                    <padding><Insets left="8" /></padding>
                    <Circle fx:id="topBarUserAvatar" fill="#7B5FF5" radius="20" />
                    <VBox spacing="1">
                        <Label fx:id="topBarUserName" style="-fx-text-fill: #e2e8f0; -fx-font-size: 14; -fx-font-weight: 600;" text="Admin" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" text="Administrator" />
                    </VBox>
                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 10;" text="▼" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT SIDEBAR - DARK -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: rgba(15, 23, 42, 0.95);">

            <!-- Logo Section -->
            <HBox alignment="CENTER_LEFT" prefHeight="80" spacing="14"
                  style="-fx-padding: 25 25; -fx-background-color: rgba(10, 15, 25, 0.8);">
                <StackPane style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #FF8C00 0%, #FF6347 100%); -fx-background-radius: 12; -fx-pref-width: 45; -fx-pref-height: 45;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: 700;" text="L" />
                </StackPane>
                <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: 700; -fx-letter-spacing: 2;" text="LAMMA" />
            </HBox>

            <Separator style="-fx-background-color: rgba(51, 65, 85, 0.3);" />

            <!-- Navigation -->
            <VBox spacing="8" style="-fx-padding: 20 15;">
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 10; -fx-font-weight: 700; -fx-padding: 0 18 8 18; -fx-letter-spacing: 1;" text="OVERVIEW" />
                <Button fx:id="dashboardBtn" alignment="CENTER_LEFT" onAction="#showDashboard" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #FF8C00 0%, #FF6347 100%); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18; -fx-effect: dropshadow(gaussian, rgba(255, 99, 71, 0.4), 10, 0, 0, 2);" text="📊  Dashboard" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="👥  Users" />
            </VBox>

            <Separator style="-fx-background-color: rgba(51, 65, 85, 0.3);" />

            <VBox spacing="8" style="-fx-padding: 20 15;">
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 10; -fx-font-weight: 700; -fx-padding: 0 18 8 18; -fx-letter-spacing: 1;" text="CAMP MANAGEMENT" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="⛺  Abonnements" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="🎯  Participations" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="🍽️  Restaurants" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="🍕  Repas" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="🍔  Menus" />
            </VBox>

            <Separator style="-fx-background-color: rgba(51, 65, 85, 0.3);" />

            <VBox spacing="8" style="-fx-padding: 20 15;">
                <Button alignment="CENTER_LEFT" onAction="#logout" prefHeight="48" prefWidth="220"
                        style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="🚪  Logout" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <BorderPane>
            <center>
                <VBox spacing="0" style="-fx-background-color: transparent;">

                    <!-- Statistics Cards - GLASSMORPHISM -->
                    <HBox spacing="20" style="-fx-padding: 30 30 20 30;">

                        <!-- Total Users Card - Glassmorphism -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane style="-fx-background-color: rgba(139, 92, 246, 0.2); -fx-background-radius: 10; -fx-pref-width: 45; -fx-pref-height: 45;">
                                    <Label style="-fx-font-size: 22; -fx-text-fill: #a78bfa;" text="👥" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-font-weight: 600; -fx-letter-spacing: 0.5;" text="TOTAL USERS" />
                                    <Label fx:id="totalUsersLabel" style="-fx-font-size: 32; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 18;" text="⋮" />
                            </HBox>
                        </VBox>

                        <!-- Admin Users Card -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane style="-fx-background-color: rgba(59, 130, 246, 0.2); -fx-background-radius: 10; -fx-pref-width: 45; -fx-pref-height: 45;">
                                    <Label style="-fx-font-size: 22; -fx-text-fill: #60a5fa;" text="👑" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-font-weight: 600; -fx-letter-spacing: 0.5;" text="ADMINS" />
                                    <Label fx:id="adminUsersLabel" style="-fx-font-size: 32; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 18;" text="⋮" />
                            </HBox>
                        </VBox>

                        <!-- Regular Users Card -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.2); -fx-background-radius: 10; -fx-pref-width: 45; -fx-pref-height: 45;">
                                    <Label style="-fx-font-size: 22; -fx-text-fill: #34d399;" text="👤" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-font-weight: 600; -fx-letter-spacing: 0.5;" text="REGULAR USERS" />
                                    <Label fx:id="regularUsersLabel" style="-fx-font-size: 32; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 18;" text="⋮" />
                            </HBox>
                        </VBox>

                        <!-- Weather Card (Unavailable) -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 16; -fx-padding: 20; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 16; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <StackPane style="-fx-background-color: rgba(251, 191, 36, 0.2); -fx-background-radius: 10; -fx-pref-width: 45; -fx-pref-height: 45;">
                                    <Label style="-fx-font-size: 22; -fx-text-fill: #fbbf24;" text="🌤️" />
                                </StackPane>
                                <VBox spacing="2">
                                    <Label style="-fx-font-size: 11; -fx-text-fill: #94a3b8; -fx-font-weight: 600; -fx-letter-spacing: 0.5;" text="WEATHER" />
                                    <Label style="-fx-font-size: 20; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="--°C" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 18;" text="⋮" />
                            </HBox>
                            <Label style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-style: italic;" text="Unavailable" />
                        </VBox>

                    </HBox>

                    <!-- Trail Team Header -->
                    <VBox spacing="15" style="-fx-padding: 10 30 20 30;">
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <VBox spacing="2">
                                <Label style="-fx-font-size: 24; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="Trail Team" />
                                <Label style="-fx-font-size: 13; -fx-text-fill: #94a3b8;" text="Members currently out in the wild" />
                            </VBox>

                            <Region HBox.hgrow="ALWAYS" />

                            <!-- Filter Buttons -->
                            <HBox alignment="CENTER" spacing="0"
                                  style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 10; -fx-padding: 4; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 10;">
                                <Button fx:id="filterAllBtn" onAction="#sortRecent"
                                        style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #FF8C00 0%, #FF6347 100%); -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 12; -fx-font-weight: 600; -fx-padding: 8 16; -fx-cursor: hand;" text="All Users" />
                                <Button fx:id="filterAlphabetBtn" onAction="#sortAlphabet"
                                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 8; -fx-font-size: 12; -fx-font-weight: 500; -fx-padding: 8 16; -fx-cursor: hand;" text="A-Z" />
                                <Button fx:id="filterLatestBtn" onAction="#sortLatest"
                                        style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-background-radius: 8; -fx-font-size: 12; -fx-font-weight: 500; -fx-padding: 8 16; -fx-cursor: hand;" text="Latest" />
                            </HBox>

                            <Button onAction="#handleAddUser"
                                    style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #FF8C00 0%, #FF6347 100%); -fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 600; -fx-background-radius: 10; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(255, 99, 71, 0.4), 10, 0, 0, 2);" text="➕  New Member" />
                        </HBox>
                    </VBox>

                    <!-- Users Grid - Glassmorphism Cards -->
                    <ScrollPane fitToWidth="true" prefHeight="550"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <GridPane fx:id="usersGrid" hgap="20" vgap="20" style="-fx-padding: 0 30 30 30;">
                                <!-- User cards dynamically loaded -->
                            </GridPane>
                        </content>
                    </ScrollPane>

                </VBox>
            </center>

            <!-- RIGHT SIDEBAR - Dark Glassmorphism -->
            <right>
                <VBox fx:id="detailsSidebar" prefWidth="350" spacing="0"
                      style="-fx-background-color: rgba(30, 41, 59, 0.6); -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 0 0 0 1;">

                    <HBox alignment="CENTER_LEFT" prefHeight="80"
                          style="-fx-background-color: rgba(15, 23, 42, 0.5); -fx-padding: 25; -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 0 0 1 0;">
                        <Label style="-fx-font-size: 18; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="User Details" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="editBtn" onAction="#toggleSidebar"
                                style="-fx-background-color: rgba(51, 65, 85, 0.4); -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8; -fx-border-color: rgba(100, 116, 139, 0.3); -fx-border-width: 1; -fx-border-radius: 8;">
                            <graphic>
                                <Label text="✏️" style="-fx-font-size: 16;" />
                            </graphic>
                        </Button>
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <VBox spacing="25" style="-fx-padding: 30;">

                                <VBox alignment="CENTER" spacing="15">
                                    <StackPane>
                                        <Circle fx:id="profileAvatar" fill="#7B5FF5" radius="65"
                                                style="-fx-effect: dropshadow(gaussian, rgba(123, 95, 245, 0.4), 15, 0, 0, 3);" />
                                    </StackPane>
                                    <VBox alignment="CENTER" spacing="6">
                                        <Label fx:id="profileName" style="-fx-font-size: 22; -fx-font-weight: 700; -fx-text-fill: #e2e8f0;" text="Select a user" />
                                        <Label fx:id="profileRole" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: white; -fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #FF8C00 0%, #FF6347 100%); -fx-background-radius: 6; -fx-padding: 4 12;" text="ROLE" />
                                    </VBox>
                                </VBox>

                                <Separator style="-fx-background-color: rgba(100, 116, 139, 0.2);" />

                                <VBox spacing="20">
                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 10; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 0.5;" text="EMAIL ADDRESS" />
                                        <HBox alignment="CENTER_LEFT" spacing="10"
                                              style="-fx-background-color: rgba(51, 65, 85, 0.3); -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 1; -fx-border-radius: 8;">
                                            <Label style="-fx-font-size: 16; -fx-text-fill: #94a3b8;" text="📧" />
                                            <Label fx:id="profileEmail" style="-fx-font-size: 14; -fx-text-fill: #cbd5e1; -fx-font-weight: 500;" text="email@example.com" />
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 10; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 0.5;" text="PHONE NUMBER" />
                                        <HBox alignment="CENTER_LEFT" spacing="10"
                                              style="-fx-background-color: rgba(51, 65, 85, 0.3); -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 1; -fx-border-radius: 8;">
                                            <Label style="-fx-font-size: 16; -fx-text-fill: #94a3b8;" text="📱" />
                                            <Label fx:id="profilePhone" style="-fx-font-size: 14; -fx-text-fill: #cbd5e1; -fx-font-weight: 500;" text="-" />
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 10; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 0.5;" text="MOTORIZED" />
                                        <HBox alignment="CENTER_LEFT" spacing="10"
                                              style="-fx-background-color: rgba(51, 65, 85, 0.3); -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 1; -fx-border-radius: 8;">
                                            <Label style="-fx-font-size: 16; -fx-text-fill: #94a3b8;" text="🚗" />
                                            <Label fx:id="profileMotorized" style="-fx-font-size: 14; -fx-font-weight: 600; -fx-text-fill: #cbd5e1;" text="-" />
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 10; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 0.5;" text="ACCOUNT STATUS" />
                                        <HBox alignment="CENTER_LEFT" spacing="10"
                                              style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: rgba(16, 185, 129, 0.3); -fx-border-width: 1; -fx-border-radius: 8;">
                                            <Label style="-fx-font-size: 16;" text="✅" />
                                            <Label style="-fx-font-size: 14; -fx-text-fill: #34d399; -fx-font-weight: 600;" text="Active" />
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <Separator style="-fx-background-color: rgba(100, 116, 139, 0.2);" />

                                <VBox spacing="12">
                                    <Label style="-fx-font-size: 10; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 0.5;" text="QUICK ACTIONS" />
                                    <Button alignment="CENTER_LEFT" prefWidth="290"
                                            style="-fx-background-color: rgba(51, 65, 85, 0.3); -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand; -fx-border-color: rgba(100, 116, 139, 0.2); -fx-border-width: 1; -fx-border-radius: 8;" text="📧  Send Email" />
                                    <Button fx:id="deleteUserBtn" onAction="#handleDeleteFromDetails" alignment="CENTER_LEFT" prefWidth="290"
                                            style="-fx-background-color: rgba(239, 68, 68, 0.1); -fx-text-fill: #f87171; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand; -fx-border-color: rgba(239, 68, 68, 0.3); -fx-border-width: 1; -fx-border-radius: 8;" text="🗑️  Delete User" />
                                </VBox>

                            </VBox>
                        </content>
                    </ScrollPane>

                </VBox>
            </right>

        </BorderPane>
    </center>

</BorderPane>
