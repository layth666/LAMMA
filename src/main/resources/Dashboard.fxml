<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="900.0" prefWidth="1600.0" style="-fx-background-color: #f8f9fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">

    <!-- TOP BAR -->
    <top>
        <VBox>
            <!-- Windows Controls -->
            <HBox alignment="CENTER_RIGHT" prefHeight="32" style="-fx-background-color: white;">
                <Button onAction="#minimizeWindow" prefHeight="32" prefWidth="45" style="-fx-background-color: transparent; -fx-text-fill: #6c757d; -fx-cursor: hand;" text="─" />
                <Button onAction="#maximizeWindow" prefHeight="32" prefWidth="45" style="-fx-background-color: transparent; -fx-text-fill: #6c757d; -fx-cursor: hand;" text="❐" />
                <Button onAction="#closeWindow" prefHeight="32" prefWidth="45" style="-fx-background-color: transparent; -fx-text-fill: #dc2626; -fx-cursor: hand;" text="✕" />
            </HBox>

            <!-- Clean Top Bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="80.0" style="-fx-background-color: white; -fx-border-color: #e9ecef; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets left="280" right="40" />
                </padding>

                <!-- Search Bar - Clean -->
                <HBox alignment="CENTER_LEFT" prefWidth="450" spacing="12" style="-fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-padding: 14 20;">
                    <Label style="-fx-text-fill: #6c757d; -fx-font-size: 16;" text="🔍" />
                    <TextField fx:id="searchField" promptText="Search users..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-font-size: 14; -fx-text-fill: #1e293b;">
                        <HBox.hgrow>ALWAYS</HBox.hgrow>
                    </TextField>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- User Profile - Clean with AVATAR -->
                <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f8f9fa; -fx-background-radius: 25; -fx-padding: 8 20 8 8; -fx-cursor: hand;">
                    <!-- ✅ Avatar Circle with fx:id -->
                    <Circle fx:id="topBarUserAvatar" fill="#7B5FF5" radius="20" />
                    <VBox spacing="1">
                        <Label fx:id="topBarUserName" style="-fx-text-fill: #1e293b; -fx-font-size: 14; -fx-font-weight: 600;" text="Admin" />
                        <Label style="-fx-text-fill: #6c757d; -fx-font-size: 11;" text="Administrator" />
                    </VBox>
                    <Label style="-fx-text-fill: #6c757d; -fx-font-size: 10;" text="▼" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: #1e293b;">

            <!-- Logo Section - Same Level as Cards -->
            <HBox alignment="CENTER_LEFT" prefHeight="80" spacing="14" style="-fx-padding: 25 25; -fx-background-color: #0f172a;">
                <StackPane style="-fx-background-color: #7B5FF5; -fx-background-radius: 12; -fx-pref-width: 45; -fx-pref-height: 45;">
                    <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: 700;" text="L" />
                </StackPane>
                <Label style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: 700; -fx-letter-spacing: 1;" text="LAMMA" />
            </HBox>

            <Separator style="-fx-background-color: #334155;" />

            <!-- Navigation -->
            <VBox spacing="8" style="-fx-padding: 20 15;">
                <Button fx:id="dashboardBtn" alignment="CENTER_LEFT" onAction="#showDashboard" prefHeight="48" prefWidth="220" style="-fx-background-color: #7B5FF5; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="📊  Dashboard" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="👥  Users" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="📁  Projects" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="📊  Analytics" />
            </VBox>

            <Separator style="-fx-background-color: #334155;" />

            <VBox spacing="8" style="-fx-padding: 20 15;">
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 11; -fx-font-weight: 700; -fx-padding: 0 18 8 18;" text="SETTINGS" />
                <Button alignment="CENTER_LEFT" prefHeight="48" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #cbd5e1; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="⚙️  Preferences" />
                <Button alignment="CENTER_LEFT" onAction="#logout" prefHeight="48" prefWidth="220" style="-fx-background-color: transparent; -fx-text-fill: #f87171; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 18;" text="🚪  Logout" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <BorderPane>

            <!-- CENTER - Users List -->
            <center>
                <VBox spacing="0" style="-fx-background-color: #f8f9fa;">

                    <!-- Statistics Cards - AU-DESSUS de la liste -->
                    <HBox spacing="25" style="-fx-padding: 30 30 20 30;">

                        <!-- Total Users Card -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane style="-fx-background-color: #ede9fe; -fx-background-radius: 12; -fx-pref-width: 55; -fx-pref-height: 55;">
                                    <Label style="-fx-font-size: 26; -fx-text-fill: #7B5FF5;" text="👥" />
                                </StackPane>
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="TOTAL USERS" />
                                    <Label fx:id="totalUsersLabel" style="-fx-font-size: 36; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="0" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-text-fill: #10b981; -fx-font-size: 12; -fx-font-weight: 600; -fx-background-color: #d1fae5; -fx-background-radius: 6; -fx-padding: 4 8;" text="↗ +12%" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="from last month" />
                            </HBox>
                        </VBox>

                        <!-- Admin Users Card -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane style="-fx-background-color: #dbeafe; -fx-background-radius: 12; -fx-pref-width: 55; -fx-pref-height: 55;">
                                    <Label style="-fx-font-size: 26; -fx-text-fill: #3b82f6;" text="👑" />
                                </StackPane>
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="ADMINS" />
                                    <Label fx:id="adminUsersLabel" style="-fx-font-size: 36; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="0" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-text-fill: #3b82f6; -fx-font-size: 12; -fx-font-weight: 600; -fx-background-color: #dbeafe; -fx-background-radius: 6; -fx-padding: 4 8;" text="↗ +2" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="new this week" />
                            </HBox>
                        </VBox>

                        <!-- Regular Users Card -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <StackPane style="-fx-background-color: #d1fae5; -fx-background-radius: 12; -fx-pref-width: 55; -fx-pref-height: 55;">
                                    <Label style="-fx-font-size: 26; -fx-text-fill: #10b981;" text="👤" />
                                </StackPane>
                                <VBox spacing="5">
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-font-weight: 600;" text="REGULAR USERS" />
                                    <Label fx:id="regularUsersLabel" style="-fx-font-size: 36; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="0" />
                                </VBox>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-text-fill: #10b981; -fx-font-size: 12; -fx-font-weight: 600; -fx-background-color: #d1fae5; -fx-background-radius: 6; -fx-padding: 4 8;" text="↗ +8%" />
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="from last month" />
                            </HBox>
                        </VBox>

                    </HBox>

                    <!-- Users Section Header -->
                    <VBox spacing="20" style="-fx-padding: 10 30 25 30;">
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <VBox spacing="4">
                                <Label style="-fx-font-size: 24; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Team Members" />
                                <Label style="-fx-font-size: 14; -fx-text-fill: #64748b;" text="Manage your team and permissions" />
                            </VBox>

                            <Region HBox.hgrow="ALWAYS" />

                            <!-- Filter Tabs with Animated Indicator -->
                            <HBox fx:id="filterContainer" alignment="CENTER" spacing="0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                                <Button fx:id="filterAllBtn" onAction="#sortRecent" style="-fx-background-color: #7B5FF5; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-size: 13; -fx-font-weight: 600; -fx-padding: 10 20; -fx-cursor: hand;" text="All Users" />
                                <Button fx:id="filterAlphabetBtn" onAction="#sortAlphabet" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-background-radius: 8; -fx-font-size: 13; -fx-font-weight: 500; -fx-padding: 10 20; -fx-cursor: hand;" text="A-Z" />
                                <Button fx:id="filterLatestBtn" onAction="#sortLatest" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-background-radius: 8; -fx-font-size: 13; -fx-font-weight: 500; -fx-padding: 10 20; -fx-cursor: hand;" text="Latest" />
                            </HBox>

                            <Button onAction="#handleAddUser" style="-fx-background-color: #7B5FF5; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 10; -fx-padding: 14 28; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(123,95,245,0.3), 12, 0, 0, 4);" text="➕  Add User" />
                        </HBox>
                    </VBox>

                    <!-- Users Grid -->
                    <ScrollPane fitToWidth="true" prefHeight="550" style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <GridPane fx:id="usersGrid" hgap="25" vgap="25" style="-fx-padding: 0 30 30 30;">
                                <!-- User cards with images loaded dynamically -->
                            </GridPane>
                        </content>
                    </ScrollPane>

                </VBox>
            </center>

            <!-- RIGHT SIDEBAR - User Details -->
            <right>
                <VBox fx:id="detailsSidebar" prefWidth="350" spacing="0" style="-fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 0 1;">

                    <HBox alignment="CENTER_LEFT"
                          prefHeight="80"
                          style="-fx-background-color: #f8f9fa; -fx-padding: 25; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">

                        <Label style="-fx-font-size: 18; -fx-font-weight: 700; -fx-text-fill: #1e293b;"
                               text="User Details" />

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- ✏️ EDIT BUTTON -->
                        <Button fx:id="editBtn"
                                onAction="#toggleSidebar"
                                style="-fx-background-color: #f1f5f9; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8;">

                            <graphic>
                                <Label text="✏️"
                                       style="-fx-font-size: 16; -fx-text-fill: #64748b;" />
                            </graphic>

                        </Button>

                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-background: white;">
                        <content>
                            <VBox spacing="25" style="-fx-padding: 30;">

                                <VBox alignment="CENTER" spacing="15">
                                    <StackPane>
                                        <!-- ✅ Profile Avatar Circle with fx:id -->
                                        <Circle fx:id="profileAvatar" fill="#e0e7ff" radius="65" />
                                    </StackPane>
                                    <VBox alignment="CENTER" spacing="6">
                                        <Label fx:id="profileName" style="-fx-font-size: 22; -fx-font-weight: 700; -fx-text-fill: #1e293b;" text="Select a user" />
                                        <Label fx:id="profileRole" style="-fx-font-size: 13; -fx-font-weight: 600; -fx-text-fill: white; -fx-background-color: #7B5FF5; -fx-background-radius: 6; -fx-padding: 4 12;" text="ROLE" />
                                    </VBox>
                                </VBox>

                                <Separator />

                                <VBox spacing="20">
                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 11; -fx-font-weight: 700; -fx-text-fill: #64748b;" text="EMAIL ADDRESS" />
                                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 12;">
                                            <Label style="-fx-font-size: 16; -fx-text-fill: #64748b;" text="📧" />
                                            <Label fx:id="profileEmail" style="-fx-font-size: 14; -fx-text-fill: #1e293b; -fx-font-weight: 500;" text="email@example.com" />
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 11; -fx-font-weight: 700; -fx-text-fill: #64748b;" text="PHONE NUMBER" />
                                        <HBox alignment="CENTER_LEFT" spacing="10"
                                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 12;">
                                            <Label style="-fx-font-size: 16;" text="📱" />
                                            <Label fx:id="profilePhone"
                                                   style="-fx-font-size: 14; -fx-text-fill: #1e293b; -fx-font-weight: 500;"
                                                   text="-" />
                                        </HBox>
                                    </VBox>

                                    <!-- MOTORIZED -->
                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 11; -fx-font-weight: 700; -fx-text-fill: #64748b;" text="MOTORIZED" />
                                        <HBox alignment="CENTER_LEFT" spacing="10"
                                              style="-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 12;">
                                            <Label style="-fx-font-size: 16;" text="🚗" />
                                            <Label fx:id="profileMotorized"
                                                   style="-fx-font-size: 14; -fx-font-weight: 600;"
                                                   text="-" />
                                        </HBox>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label style="-fx-font-size: 11; -fx-font-weight: 700; -fx-text-fill: #64748b;" text="ACCOUNT STATUS" />
                                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #f0fdf4; -fx-background-radius: 8; -fx-padding: 12;">
                                            <Label style="-fx-font-size: 16;" text="✅" />
                                            <Label style="-fx-font-size: 14; -fx-text-fill: #16a34a; -fx-font-weight: 600;" text="Active" />
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <Separator />

                                <VBox spacing="12">
                                    <Label style="-fx-font-size: 11; -fx-font-weight: 700; -fx-text-fill: #64748b;" text="QUICK ACTIONS" />
                                    <Button alignment="CENTER_LEFT" prefWidth="290" style="-fx-background-color: #f8f9fa; -fx-text-fill: #1e293b; -fx-font-size: 14; -fx-font-weight: 500; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;" text="📧  Send Email" />
                                    <Button fx:id="deleteUserBtn"
                                            onAction="#handleDeleteFromDetails"
                                            alignment="CENTER_LEFT"
                                            prefWidth="290"
                                            style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 14; -fx-font-weight: 600; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;"
                                            text="🗑️  Delete User" />
                                </VBox>

                            </VBox>
                        </content>
                    </ScrollPane>

                </VBox>
            </right>

        </BorderPane>
    </center>

</BorderPane>
